{
  "name": "@unlocalhosted/browsergrad-semantic-core",
  "version": "0.2.0",
  "description": "Versioned BrowserGrad semantic schemas, canonical wire formats, and value/layout verification.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js"
    },
    "./fixtures/kernel-v1/dense-permutation-view-copy.cases.json": "./fixtures/kernel-v1/dense-permutation-view-copy.cases.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "python/",
    "fixtures/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.0.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0"
  },
  "sideEffects": false
}
