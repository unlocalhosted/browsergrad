            {
              "kind": "lessEqual",
              "lhs": { "kind": "const", "value": "0" },
              "rhs": { "kind": "coordinate", "axis": 1 }
            },
            {
              "kind": "lessEqual",
              "lhs": {
                "kind": "add",
                "terms": [
                  { "kind": "coordinate", "axis": 1 },
                  { "kind": "const", "value": "1" }
                ]
              },
              "rhs": { "kind": "const", "value": "2" }
            },
            {
              "kind": "lessEqual",
              "lhs": { "kind": "const", "value": "0" },
              "rhs": { "kind": "coordinate", "axis": 2 }
            },
            {
              "kind": "lessEqual",
              "lhs": {
                "kind": "add",
                "terms": [
                  { "kind": "coordinate", "axis": 2 },
                  { "kind": "const", "value": "1" }
                ]
