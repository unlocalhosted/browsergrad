      "id": "compiler.pointer-scalar-memory.pointer-array-rebind.v0",
      "source": "__global__ void conditional_pointer_array_rebind(uint *left, uint *right, uint *out, int select) {\n  uint *ptrs[2];\n  ptrs[0] = left;\n  ptrs[1] = right;\n  ptrs[select != 0 ? 1 : 0] = select != 0 ? left : right;\n  *ptrs[select != 0 ? 1 : 0] = 7u;\n  out[0] = left[0];\n  out[1] = right[0];\n}",
      "workgroupSize": [1, 1, 1],
      "operationKinds": [
