      "id": "compiler.pointer-scalar-memory.storage-rebase.v0",
      "source": "__global__ void pointer_rebase(uint* x, uint* out, int offset) {\n  x += offset;\n  if (threadIdx.x == 0) {\n    out[0] = x[0];\n    x -= 1;\n    out[1] = x[0];\n    x++;\n    out[2] = *x;\n  }\n}",
      "workgroupSize": [1, 1, 1],
      "operationKinds": ["store", "branch", "store", "store", "store", "store", "store"],
      "requiredSymbolFacts": [
        {
          "name": "x",
          "pointer": true
        }
      ],
      "scenarios": [
        {
          "buffers": {
            "x": { "type": "Uint32Array", "values": [10, 20, 30, 40] },
            "out": { "type": "Uint32Array", "values": [0, 0, 0] }
          },
          "scalars": { "offset": 2 },
          "expectedBuffers": { "out": [30, 20, 30] },
          "referenceTiers": ["semantic-cpu-reference"]
        }
      ],
      "wgslEligible": true
    },
