        "pointer-array-rebind",
        "pointer-array-rebind",
        "branch",
        "pointer-array-rebind",
        "pointer-array-rebind",
        "store",
        "store",
        "store"
      ],
      "requiredSymbolFacts": [
        {
          "name": "ptrs",
          "pointer": true,
          "pointerArrayAliasCount": 2
        }
      ],
