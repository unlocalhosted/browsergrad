{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_plan.mjs",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_plan.d.mts",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_executor.mjs",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_executor.d.mts",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_log_sink.mjs",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_executor_process.mjs",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_runner.mjs",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_reproducibility.mjs",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_build_reproducibility.d.mts",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_worker_bundle_authoring.mjs",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_worker_bundle_authoring.d.mts",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_wasm_review.mjs",
    "scripts/cpp_cute_browser_build/cpp_cute_browser_wasm_review.d.mts",
    "scripts/cpp_cute_browser_build/*.test.ts",
    "scripts/cpp_cute_browser_build/vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
