{
  "schemaVersion": 1,
  "adapterId": "grad.view-bf16-compat.v0",
  "environment": {
    "pyodide": "0.26.4",
    "numpy": "1.26.4"
  },
  "cases": [
    {
      "id": "grad.dtype.alias-registry.v0",
      "expected": {
        "bool": ["bool", 1],
        "double": ["float64", 8],
        "float": ["float32", 4],
        "float16": ["float16", 2],
        "float32": ["float32", 4],
        "float64": ["float64", 8],
        "fp16": ["float16", 2],
        "half": ["float16", 2],
        "int": ["int32", 4],
        "int16": ["int16", 2],
        "int32": ["int32", 4],
        "int64": ["int64", 8],
        "int8": ["int8", 1],
        "long": ["int64", 8],
        "short": ["int16", 2],
        "uint8": ["uint8", 1]
      }
    },
    {
      "id": "grad.dtype.numpy-string-fallback.v0",
      "expected": {
        "dtype": "complex64",
        "itemsize": 8
      }
    },
    {
      "id": "grad.dtype.constructor-defaults.v0",
      "expected": {
        "tensorInteger": "float32",
        "tensorFloat": "float32",
        "torchInteger": "int64",
        "torchFloat": "float32"
      }
    },
    {
      "id": "grad.dtype.bf16-rejected.v1",
      "expected": {
        "bf16Constructor": "NotImplementedError: browsergrad-grad does not provide bfloat16 storage or conversion; use an explicitly supported dtype such as 'float32'",
        "bfloat16Constructor": "NotImplementedError: browsergrad-grad does not provide bfloat16 storage or conversion; use an explicitly supported dtype such as 'float32'",
        "toBfloat16": "NotImplementedError: browsergrad-grad does not provide bfloat16 storage or conversion; use an explicitly supported dtype such as 'float32'"
      }
    },
    {
      "id": "grad.dtype.torch-bfloat16-token-distinct-unsupported.v1",
      "expected": {
        "token": "bfloat16",
        "distinctFromFloat32": true,
        "constructor": "NotImplementedError: browsergrad-grad does not provide bfloat16 storage or conversion; use an explicitly supported dtype such as 'float32'"
      }
    },
    {
      "id": "grad.interop.from-numpy-f32-alias.v0",
      "expected": {
        "sharesMemory": true,
        "sourceMutationVisible": true,
        "tensorMutationVisible": true,
        "dtype": "float32"
      }
    },
    {
      "id": "grad.interop.from-numpy-f64-materializes.v0",
      "expected": {
        "sharesMemory": false,
        "sourceMutationVisible": false,
        "dtype": "float32"
      }
    },
    {
      "id": "grad.view.reshape-contiguous-alias.v0",
      "expected": {
        "sharesMemory": true,
        "cContiguous": true,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true,
        "backwardGradient": [[1, 1, 1], [1, 1, 1]]
      }
    },
    {
      "id": "grad.view.view-direct-alias.v0",
      "expected": {
        "sharesMemory": true,
        "parentIdentity": true,
        "backwardGradient": [[1, 1, 1], [1, 1, 1]]
      }
    },
    {
      "id": "grad.view.reshape-noncontiguous-materializes.v0",
      "expected": {
        "sharesMemory": false,
        "cContiguous": true,
        "requiresGrad": true,
        "graphEdge": true
      }
    },
    {
      "id": "grad.view.reshape-float16-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "float16",
        "resultDtype": "float16"
      }
    },
    {
      "id": "grad.view.transpose-alias.v0",
      "expected": {
        "sharesMemory": true,
        "cContiguous": false,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true,
        "backwardGradient": [[1, 1, 1], [1, 1, 1]]
      }
    },
    {
      "id": "grad.view.transpose-float16-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "float16",
        "resultDtype": "float16"
      }
    },
    {
      "id": "grad.view.transpose-bool-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "bool",
        "resultDtype": "bool"
      }
    },
    {
      "id": "grad.view.permute-alias.v0",
      "expected": {
        "sharesMemory": true,
        "cContiguous": false,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true,
        "backwardGradientSum": 24
      }
    },
    {
      "id": "grad.view.permute-float16-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "float16",
        "resultDtype": "float16"
      }
    },
    {
      "id": "grad.materialization.expand-copy.v0",
      "expected": {
        "sharesMemory": false,
        "cContiguous": true,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "backwardGradient": [[3], [3]],
        "validMinusOneValues": [[1, 1, 1], [2, 2, 2]],
        "invalidShapeErrors": {
          "float": "ValueError",
          "bool": "ValueError",
          "leadingMinusOne": "ValueError",
          "negative": "ValueError",
          "incompatible": "ValueError",
          "fewerDimensions": "ValueError"
        }
      }
    },
    {
      "id": "grad.materialization.expand-dtype-preservation.v0",
      "expected": {
        "float16SourceDtype": "float16",
        "float16ResultDtype": "float16",
        "int32SourceDtype": "int32",
        "int32ResultDtype": "int32"
      }
    },
    {
      "id": "grad.view.basic-slice-alias.v0",
      "expected": {
        "sharesMemory": true,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true,
        "backwardGradient": [[0, 1, 1], [0, 1, 1]]
      }
    },
    {
      "id": "grad.view.fancy-index-materializes.v0",
      "expected": {
        "sharesMemory": false,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "backwardGradient": [[2, 2, 2], [0, 0, 0]]
      }
    },
    {
      "id": "grad.view.basic-slice-int64-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "int64",
        "resultDtype": "int64"
      }
    },
    {
      "id": "grad.materialization.contiguous-copy.v1",
      "expected": {
        "sameObject": false,
        "sharesMemory": false,
        "cContiguousBefore": false,
        "cContiguousAfter": true,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": false,
        "resultMutationVisible": false,
        "backwardGradient": [[1, 1], [1, 1], [1, 1]]
      }
    },
    {
      "id": "grad.materialization.contiguous-identity.v1",
      "expected": {
        "sameObject": true,
        "cContiguous": true,
        "graphPreserved": true
      }
    },
    {
      "id": "grad.materialization.contiguous-float16-copy.v1",
      "expected": {
        "sharesMemory": false,
        "sourceDtype": "float16",
        "resultDtype": "float16",
        "cContiguous": true
      }
    },
    {
      "id": "grad.view.detach-alias.v1",
      "expected": {
        "sameObject": false,
        "sharesMemory": true,
        "requiresGrad": false,
        "graphEdge": false,
        "isLeaf": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true
      }
    },
    {
      "id": "grad.view.detach-float16-alias.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "float16",
        "resultDtype": "float16",
        "requiresGrad": false
      }
    },
    {
      "id": "grad.view.detach-noncontiguous-alias.v1",
      "expected": {
        "sharesMemory": true,
        "cContiguousBefore": false,
        "cContiguousAfter": false,
        "stridesPreserved": true
      }
    },
    {
      "id": "grad.interop.numpy-copy.v0",
      "expected": {
        "sharesMemory": false,
        "sourceMutationVisible": false,
        "arrayMutationVisible": false
      }
    },
    {
      "id": "grad.interop.array-protocol-alias.v0",
      "expected": {
        "sharesMemory": true,
        "sourceMutationVisible": true,
        "arrayMutationVisible": true
      }
    },
    {
      "id": "grad.conversion.to-same-dtype-identity.v0",
      "expected": {
        "sameObject": true,
        "requiresGrad": true,
        "graphPreserved": true
      }
    },
    {
      "id": "grad.conversion.to-cross-dtype-detaches.v0",
      "expected": {
        "sharesMemory": false,
        "dtype": "float64",
        "requiresGrad": false,
        "graphEdge": false
      }
    },
    {
      "id": "grad.conversion.to-cross-dtype-preserves-layout-order.v0",
      "expected": {
        "cContiguous": false,
        "fContiguous": true,
        "dtype": "float64"
      }
    },
    {
      "id": "grad.conversion.to-unrecognized-string-noop.v0",
      "expected": {
        "sameObject": true,
        "dtype": "float32",
        "requiresGrad": true
      }
    }
  ]
}
