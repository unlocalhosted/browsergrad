{
  "schemaVersion": 1,
  "adapterId": "grad.view-bf16-compat.v0",
  "environment": {
    "pyodide": "0.26.4",
    "numpy": "1.26.4"
  },
  "cases": [
    {
      "id": "grad.dtype.alias-registry.v1",
      "expected": {
        "bool": ["bool", 1],
        "double": ["float64", 8],
        "float": ["float32", 4],
        "float16": ["float16", 2],
        "float32": ["float32", 4],
        "float64": ["float64", 8],
        "fp16": ["float16", 2],
        "half": ["float16", 2],
        "int": ["int32", 4],
        "int16": ["int16", 2],
        "int32": ["int32", 4],
        "int64": ["int64", 8],
        "int8": ["int8", 1],
        "long": ["int64", 8],
        "short": ["int16", 2],
        "uint8": ["uint8", 1],
        "uint16": ["uint16", 2],
        "uint32": ["uint32", 4],
        "uint64": ["uint64", 8]
      }
    },
    {
      "id": "grad.dtype.numpy-spec-registry.v1",
      "expected": {
        "dtypes": [
          "bool",
          "float16",
          "float32",
          "float64",
          "int8",
          "int16",
          "int32",
          "int64",
          "uint8",
          "uint16",
          "uint32",
          "uint64"
        ]
      }
    },
    {
      "id": "grad.dtype.unsupported-rejected.v1",
      "expected": {
        "complexString": "ValueError: dtype 'complex64' is not a supported BrowserGrad dtype string. Supported aliases: bool, double, float, float16, float32, float64, fp16, half, int, int16, int32, int64, int8, long, short, uint16, uint32, uint64, uint8.",
        "numpyAbbreviation": "ValueError: dtype 'f4' is not a supported BrowserGrad dtype string. Supported aliases: bool, double, float, float16, float32, float64, fp16, half, int, int16, int32, int64, int8, long, short, uint16, uint32, uint64, uint8.",
        "complexType": "ValueError: dtype 'complex64' is not supported by BrowserGrad eager storage; supported dtypes: ['bool', 'float16', 'float32', 'float64', 'int16', 'int32', 'int64', 'int8', 'uint16', 'uint32', 'uint64', 'uint8']",
        "objectDtype": "ValueError: dtype 'object' is not supported by BrowserGrad eager storage; supported dtypes: ['bool', 'float16', 'float32', 'float64', 'int16', 'int32', 'int64', 'int8', 'uint16', 'uint32', 'uint64', 'uint8']",
        "datetimeDtype": "ValueError: dtype 'datetime64[D]' is not supported by BrowserGrad eager storage; supported dtypes: ['bool', 'float16', 'float32', 'float64', 'int16', 'int32', 'int64', 'int8', 'uint16', 'uint32', 'uint64', 'uint8']",
        "structuredDtype": "ValueError: dtype 'void32' is not supported by BrowserGrad eager storage; supported dtypes: ['bool', 'float16', 'float32', 'float64', 'int16', 'int32', 'int64', 'int8', 'uint16', 'uint32', 'uint64', 'uint8']"
      }
    },
    {
      "id": "grad.dtype.torch-unsigned-tokens.v1",
      "expected": {
        "uint8": ["uint8", "uint8"],
        "uint16": ["uint16", "uint16"],
        "uint32": ["uint32", "uint32"],
        "uint64": ["uint64", "uint64"]
      }
    },
    {
      "id": "grad.dtype.constructor-defaults.v0",
      "expected": {
        "tensorInteger": "float32",
        "tensorFloat": "float32",
        "torchInteger": "int64",
        "torchFloat": "float32"
      }
    },
    {
      "id": "grad.dtype.bf16-rejected.v1",
      "expected": {
        "bf16Constructor": "NotImplementedError: browsergrad-grad does not provide bfloat16 storage or conversion; use an explicitly supported dtype such as 'float32'",
        "bfloat16Constructor": "NotImplementedError: browsergrad-grad does not provide bfloat16 storage or conversion; use an explicitly supported dtype such as 'float32'",
        "toBfloat16": "NotImplementedError: browsergrad-grad does not provide bfloat16 storage or conversion; use an explicitly supported dtype such as 'float32'"
      }
    },
    {
      "id": "grad.dtype.torch-bfloat16-token-distinct-unsupported.v1",
      "expected": {
        "token": "bfloat16",
        "distinctFromFloat32": true,
        "constructor": "NotImplementedError: browsergrad-grad does not provide bfloat16 storage or conversion; use an explicitly supported dtype such as 'float32'"
      }
    },
    {
      "id": "grad.interop.from-numpy-alias.v1",
      "expected": {
        "dtypes": {
          "bool": "bool",
          "float16": "float16",
          "float32": "float32",
          "float64": "float64",
          "int8": "int8",
          "int16": "int16",
          "int32": "int32",
          "int64": "int64",
          "uint8": "uint8",
          "uint16": "uint16",
          "uint32": "uint32",
          "uint64": "uint64"
        },
        "allShareMemory": true,
        "sourceMutationVisible": true,
        "tensorMutationVisible": true
      }
    },
    {
      "id": "grad.interop.from-numpy-noncontiguous-alias.v1",
      "expected": {
        "sameArrayObject": true,
        "sharesMemory": true,
        "dtype": "float16",
        "stridesPreserved": true,
        "cContiguous": false,
        "fContiguous": false,
        "sourceMutationVisible": true,
        "tensorMutationVisible": true
      }
    },
    {
      "id": "grad.interop.from-numpy-invalid-rejected.v1",
      "expected": {
        "list": "TypeError: from_numpy requires a numpy.ndarray, got list",
        "readonly": "ValueError: from_numpy requires writable storage because the Tensor aliases the exact NumPy array",
        "complex64": "ValueError: from_numpy does not support dtype 'complex64'; supported storage dtypes: ['bool', 'float16', 'float32', 'float64', 'int16', 'int32', 'int64', 'int8', 'uint16', 'uint32', 'uint64', 'uint8']",
        "object": "ValueError: from_numpy does not support dtype 'object'; supported storage dtypes: ['bool', 'float16', 'float32', 'float64', 'int16', 'int32', 'int64', 'int8', 'uint16', 'uint32', 'uint64', 'uint8']"
      }
    },
    {
      "id": "grad.view.reshape-contiguous-alias.v0",
      "expected": {
        "sharesMemory": true,
        "cContiguous": true,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true,
        "backwardGradient": [[1, 1, 1], [1, 1, 1]]
      }
    },
    {
      "id": "grad.view.view-direct-alias.v0",
      "expected": {
        "sharesMemory": true,
        "parentIdentity": true,
        "backwardGradient": [[1, 1, 1], [1, 1, 1]]
      }
    },
    {
      "id": "grad.view.reshape-noncontiguous-materializes.v0",
      "expected": {
        "sharesMemory": false,
        "cContiguous": true,
        "requiresGrad": true,
        "graphEdge": true
      }
    },
    {
      "id": "grad.view.reshape-float16-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "float16",
        "resultDtype": "float16"
      }
    },
    {
      "id": "grad.view.transpose-alias.v0",
      "expected": {
        "sharesMemory": true,
        "cContiguous": false,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true,
        "backwardGradient": [[1, 1, 1], [1, 1, 1]]
      }
    },
    {
      "id": "grad.view.transpose-float16-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "float16",
        "resultDtype": "float16"
      }
    },
    {
      "id": "grad.view.transpose-bool-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "bool",
        "resultDtype": "bool"
      }
    },
    {
      "id": "grad.view.permute-alias.v0",
      "expected": {
        "sharesMemory": true,
        "cContiguous": false,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true,
        "backwardGradientSum": 24
      }
    },
    {
      "id": "grad.view.permute-float16-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "float16",
        "resultDtype": "float16"
      }
    },
    {
      "id": "grad.materialization.expand-copy.v0",
      "expected": {
        "sharesMemory": false,
        "cContiguous": true,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "backwardGradient": [[3], [3]],
        "validMinusOneValues": [[1, 1, 1], [2, 2, 2]],
        "invalidShapeErrors": {
          "float": "ValueError",
          "bool": "ValueError",
          "leadingMinusOne": "ValueError",
          "negative": "ValueError",
          "incompatible": "ValueError",
          "fewerDimensions": "ValueError"
        }
      }
    },
    {
      "id": "grad.materialization.expand-dtype-preservation.v0",
      "expected": {
        "float16SourceDtype": "float16",
        "float16ResultDtype": "float16",
        "int32SourceDtype": "int32",
        "int32ResultDtype": "int32"
      }
    },
    {
      "id": "grad.view.basic-slice-alias.v0",
      "expected": {
        "sharesMemory": true,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true,
        "backwardGradient": [[0, 1, 1], [0, 1, 1]]
      }
    },
    {
      "id": "grad.view.fancy-index-materializes.v0",
      "expected": {
        "sharesMemory": false,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "backwardGradient": [[2, 2, 2], [0, 0, 0]]
      }
    },
    {
      "id": "grad.view.basic-slice-int64-alias-preserves-dtype.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "int64",
        "resultDtype": "int64"
      }
    },
    {
      "id": "grad.materialization.contiguous-copy.v1",
      "expected": {
        "sameObject": false,
        "sharesMemory": false,
        "cContiguousBefore": false,
        "cContiguousAfter": true,
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceMutationVisible": false,
        "resultMutationVisible": false,
        "backwardGradient": [[1, 1], [1, 1], [1, 1]]
      }
    },
    {
      "id": "grad.materialization.contiguous-identity.v1",
      "expected": {
        "sameObject": true,
        "cContiguous": true,
        "graphPreserved": true
      }
    },
    {
      "id": "grad.materialization.contiguous-float16-copy.v1",
      "expected": {
        "sharesMemory": false,
        "sourceDtype": "float16",
        "resultDtype": "float16",
        "cContiguous": true
      }
    },
    {
      "id": "grad.view.detach-alias.v1",
      "expected": {
        "sameObject": false,
        "sharesMemory": true,
        "requiresGrad": false,
        "graphEdge": false,
        "isLeaf": true,
        "sourceMutationVisible": true,
        "resultMutationVisible": true
      }
    },
    {
      "id": "grad.view.detach-float16-alias.v1",
      "expected": {
        "sharesMemory": true,
        "sourceDtype": "float16",
        "resultDtype": "float16",
        "requiresGrad": false
      }
    },
    {
      "id": "grad.view.detach-noncontiguous-alias.v1",
      "expected": {
        "sharesMemory": true,
        "cContiguousBefore": false,
        "cContiguousAfter": false,
        "stridesPreserved": true
      }
    },
    {
      "id": "grad.interop.numpy-export-snapshot.v1",
      "expected": {
        "numpySharesMemory": false,
        "arraySharesMemory": false,
        "sourceMutationReachedNumpy": false,
        "sourceMutationReachedArray": false,
        "numpyMutationReachedSource": false,
        "arrayMutationReachedSource": false,
        "sourceDtype": "float16",
        "numpyDtype": "float16",
        "arrayDtype": "float16",
        "typedArrayDtype": "float64",
        "numpyFContiguous": true,
        "arrayFContiguous": true,
        "copyFalseError": "ValueError: Tensor.__array__(copy=False) is unavailable: BrowserGrad exports owning snapshots rather than mutable storage aliases",
        "invalidCopyError": "TypeError: Tensor.__array__ copy must be bool or None, got str"
      }
    },
    {
      "id": "grad.conversion.to-same-dtype-identity.v0",
      "expected": {
        "sameObject": true,
        "requiresGrad": true,
        "graphPreserved": true
      }
    },
    {
      "id": "grad.conversion.to-cross-floating-autograd.v1",
      "expected": {
        "sharesMemory": false,
        "dtype": "float64",
        "requiresGrad": true,
        "graphEdge": true,
        "parentIdentity": true,
        "sourceGradientDtype": "float32",
        "sourceGradient": [1, 2]
      }
    },
    {
      "id": "grad.conversion.to-cross-floating-float16-layout.v1",
      "expected": {
        "cContiguous": false,
        "fContiguous": true,
        "sourceDtype": "float16",
        "resultDtype": "float64",
        "requiresGrad": true,
        "sourceGradientDtype": "float16",
        "sourceGradient": [[1, 1], [1, 1], [1, 1]]
      }
    },
    {
      "id": "grad.conversion.to-cross-floating-no-grad.v1",
      "expected": {
        "dtype": "float64",
        "requiresGrad": false,
        "graphEdge": false
      }
    },
    {
      "id": "grad.conversion.to-cross-nonfloating-detached.v1",
      "expected": {
        "dtype": "int64",
        "values": [1, -2],
        "requiresGrad": false,
        "graphEdge": false
      }
    },
    {
      "id": "grad.conversion.to-invalid-request-rejected.v1",
      "expected": {
        "invalidPositional": "ValueError",
        "invalidKeyword": "ValueError",
        "unsupportedKeyword": "TypeError",
        "duplicateDtype": "TypeError",
        "duplicateDtypeNone": "TypeError",
        "duplicateDeviceNone": "TypeError",
        "tooManyArguments": "TypeError",
        "ambiguousTwoPositional": "TypeError",
        "invalidDeviceType": "TypeError"
      }
    },
    {
      "id": "grad.device.tensor-cpu-identity.v1",
      "expected": {
        "positionalSameObject": true,
        "keywordSameObject": true,
        "cpuMethodSameObject": true,
        "combinedDtype": "float64",
        "combinedRequiresGrad": true,
        "combinedParentIdentity": true,
        "otherDtype": "float64",
        "otherParentIdentity": true
      }
    },
    {
      "id": "grad.device.tensor-unsupported-rejected.v1",
      "expected": {
        "toCuda": "NotImplementedError",
        "toCudaIndex": "NotImplementedError",
        "toMps": "NotImplementedError",
        "toIndexedCpu": "NotImplementedError",
        "cudaMethod": "NotImplementedError"
      }
    },
    {
      "id": "grad.device.torch-tensor-constructor.v1",
      "expected": {
        "cpuDtype": "int64",
        "cudaError": "NotImplementedError",
        "cudaIndexError": "NotImplementedError",
        "invalidDeviceType": "TypeError"
      }
    },
    {
      "id": "grad.device.module-to.v1",
      "expected": {
        "noArgumentSameObject": true,
        "cpuSameObject": true,
        "cpuKeywordSameObject": true,
        "cudaError": "NotImplementedError",
        "dtypeError": "NotImplementedError",
        "unsupportedKeyword": "TypeError",
        "duplicateDevice": "TypeError"
      }
    }
  ]
}
