{
  "name": "@unlocalhosted/browsergrad-kernels",
  "version": "0.2.0",
  "description": "WGSL kernel catalog for browser-side machine learning: matmul, softmax, layernorm, attention, and friends. Each kernel ships with a JS reference for conformance + fallback. Independent of any tensor framework.",
  "type": "module",
  "license": "MIT",
  "author": "unlocalhosted",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlocalhosted/browsergrad.git",
    "directory": "packages/browsergrad-kernels"
  },
  "homepage": "https://github.com/unlocalhosted/browsergrad/tree/main/packages/browsergrad-kernels#readme",
  "bugs": {
    "url": "https://github.com/unlocalhosted/browsergrad/issues"
  },
  "keywords": [
    "webgpu",
    "wgsl",
    "compute-shader",
    "machine-learning",
    "matmul",
    "attention",
    "browser"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reference": {
      "types": "./dist/reference.d.ts",
      "import": "./dist/reference.js"
    },
    "./wgsl_program": {
      "types": "./dist/wgsl_program.d.ts",
      "import": "./dist/wgsl_program.js"
    },
    "./float16": {
      "types": "./dist/float16.d.ts",
      "import": "./dist/float16.js"
    },
    "./cuda_concepts": {
      "types": "./dist/cuda_concepts.d.ts",
      "import": "./dist/cuda_concepts.js"
    },
    "./cuda_program": {
      "types": "./dist/cuda_program.d.ts",
      "import": "./dist/cuda_program.js"
    },
    "./rubric": {
      "types": "./dist/rubric.d.ts",
      "import": "./dist/rubric.js"
    },
    "./semantic_view_copy": {
      "types": "./dist/semantic_view_copy.d.ts",
      "import": "./dist/semantic_view_copy.js"
    },
    "./semantic_gemm": {
      "types": "./dist/semantic_gemm.d.ts",
      "import": "./dist/semantic_gemm.js"
    },
    "./semantic_attention": {
      "types": "./dist/semantic_attention.d.ts",
      "import": "./dist/semantic_attention.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:browser:view-copy": "tsc -p tsconfig.browser-view-copy.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:view-copy": "vitest run --config vitest.browser.config.ts tests-browser/semantic_view_copy_webgpu.test.ts",
    "test:browser:view-copy:required": "vitest run --mode webgpu-required --config vitest.browser.config.ts tests-browser/semantic_view_copy_webgpu.test.ts",
    "test:browser:semantic-gemm": "vitest run --config vitest.browser.config.ts tests-browser/semantic_gemm_webgpu.test.ts",
    "test:browser:semantic-gemm:required": "vitest run --mode webgpu-required --config vitest.browser.config.ts tests-browser/semantic_gemm_webgpu.test.ts",
    "test:browser:semantic-attention": "vitest run --config vitest.browser.config.ts tests-browser/semantic_attention_webgpu.test.ts",
    "test:browser:semantic-attention:required": "vitest run --mode webgpu-required --config vitest.browser.config.ts tests-browser/semantic_attention_webgpu.test.ts",
    "test:browser:semantic-attention:performance": "vitest run --config vitest.browser.config.ts tests-browser/semantic_attention_performance_webgpu.test.ts",
    "test:browser:semantic-attention:performance:required": "vitest run --mode webgpu-required --config vitest.browser.config.ts tests-browser/semantic_attention_performance_webgpu.test.ts",
    "test:browser:open": "vitest --config vitest.browser.config.ts --watch --browser.headless=false",
    "lint": "oxlint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run typecheck:browser:view-copy && pnpm run lint && pnpm run test && node scripts/require_view_copy_publish_gate.mjs"
  },
  "dependencies": {
    "@unlocalhosted/browsergrad-semantic-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@webgpu/types": "^0.1.50",
    "oxlint": "^1.0.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
