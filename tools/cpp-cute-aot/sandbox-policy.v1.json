      "maxArrayLength": 1024,
      "maxObjectProperties": 1024,
      "maxRank": 64,
      "maxIntegerBits": 256,
      "maxArithmeticOperations": 65536
    }
  },
  "semantics": {
    "linking": "forbidden",
    "userProducedNativeExecution": "forbidden",
    "externalAttestation": "required-after-receipt"
  }
}
